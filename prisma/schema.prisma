generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(USER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  emailLogs    EmailLog[]

  @@map("users")
}

// ─── Email Logs ───────────────────────────────────────────────────────────────

enum EmailType {
  SINGLE
  BULK
}

enum EmailStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model EmailLog {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id])

  type        EmailType
  status      EmailStatus
  subject     String
  recipients  String[]    // list of email addresses
  totalSent   Int         @default(0)
  totalFailed Int         @default(0)
  errors      String[]    @default([])
  messageId   String?     // SES message ID (single emails)
  sentAt      DateTime    @default(now())

  // Which domain/brand this was sent through. Denormalized as a plain
  // label (not a relation) so history stays readable even if the domain
  // is later renamed or deleted.
  domainId    String?
  domainLabel String?

  @@map("email_logs")
}

// ─── Domains ────────────────────────────────────────────────────────────────

enum MailProvider {
  SES
  CPANEL
  RESEND
}

// One document per sending domain/brand the admin has configured. Each
// domain carries its own mail-provider credentials AND its own branding,
// so the whole system (Single Email, Bulk Email, and every marketing
// template) can be pointed at any configured domain and have both the
// "how it sends" and "what it says" follow automatically. Managed via
// /api/domains by ADMIN users only. Exactly one domain should have
// isDefault = true at any time — that's what's used when a send doesn't
// explicitly specify a domainId.
model Domain {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  label     String       // display name, e.g. "Recoverlance"
  domain    String       @unique // e.g. "recoverlance.com"
  isDefault Boolean      @default(false)
  isActive  Boolean      @default(true) // disable without deleting

  active MailProvider @default(SES)

  // Sender identity used by whichever provider is active for this domain
  fromName  String @default("")
  fromEmail String @default("")
  replyTo   String @default("")

  // Amazon SES credentials
  sesRegion          String @default("us-east-1")
  sesAccessKeyId     String @default("")
  sesSecretAccessKey String @default("")

  // cPanel / generic SMTP credentials (works for any cPanel-hosted mailbox,
  // e.g. mail.yourdomain.com on port 465/587)
  smtpHost     String  @default("")
  smtpPort     Int     @default(465)
  smtpSecure   Boolean @default(true)
  smtpUsername String  @default("")
  smtpPassword String  @default("")

  // Resend credentials (https://resend.com/api-keys)
  resendApiKey String @default("")

  // ─── Branding ──────────────────────────────────────────────────────
  // Resolved into {{companyName}}, {{website}}, {{contactUrl}}, {{address}},
  // {{accentColor}}, {{unsubscribeText}} merge tags by lib/mailer.ts before
  // every send, so every template (built-in or custom) automatically
  // reflects whichever domain is selected instead of hardcoding one brand.
  companyName     String @default("")
  website         String @default("")
  contactUrl      String @default("")
  address         String @default("")
  accentColor     String @default("#6366f1")
  unsubscribeText String @default("Reply STOP to unsubscribe")

  // ─── Email Signature ─────────────────────────────────────────────────
  // Appended to the htmlBody of every outgoing email sent through this
  // domain (single + bulk, across every provider) when enabled.
  // signatureHtml is always a plain HTML string regardless of how the
  // admin built it in the UI — uploaded .html file, hand-pasted HTML, or
  // an uploaded picture wrapped as a base64 data-URI <img> tag.
  signatureEnabled Boolean @default(false)
  signatureHtml    String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("domains")
}
